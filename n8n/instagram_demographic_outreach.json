        "url": "https://api.apify.com/v2/acts/apify~instagram-scraper/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"usernames\": {{ $json.usernames }},\n  \"resultsType\": \"followers\",\n  \"resultsLimit\": {{ $json.config.max_followers_to_process }}\n}",
