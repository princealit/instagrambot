    {
      "parameters": {
        "jsCode": "// Extract usernames for follower scraping\nconst profiles = $input.all();\nconst usernames = profiles.map(p => p.json.username);\n\nreturn [{\n  json: {\n    usernames: usernames,\n    config: $('Configuration').first().json\n  }\n}];"
      },
