    {
      "parameters": {
        "jsCode": "// Prepare data for Instagram actions\nconst posts = $input.all();\nconst profile = $('5. Filter by Demographics').first().json;\n\n// Get post IDs to like\nconst postIds = posts.slice(0, 3).map(p => p.json.id || p.json.pk);\n\n// Personalize message\nconst name = (profile.full_name || '').split(' ')[0] || profile.username;\nconst message = (profile.config.dm_message || 'Hey!')\n  .replace('{name}', name)\n  .replace('{username}', profile.username);\n\nreturn [{\n  json: {\n    username: profile.username,\n    user_id: profile.user_id,\n    full_name: profile.full_name,\n    post_ids: postIds,\n    dm_message: message,\n    inferred_gender: profile.inferred_gender,\n    inferred_age_min: profile.inferred_age_min,\n    inferred_age_max: profile.inferred_age_max\n  }\n}];"
      },
