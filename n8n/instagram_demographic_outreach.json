    {
      "parameters": {
        "jsCode": "// Filter followers by following count (>= 750)\nconst config = $('Configuration').first().json;\nconst minFollowing = parseInt(config.min_following) || 750;\n\nconst followers = $input.all();\nconst qualified = followers.filter(f => {\n  const followingCount = f.json.followsCount || f.json.following_count || 0;\n  const isPrivate = f.json.isPrivate || f.json.is_private || false;\n  \n  // Must follow >= 750 people and be public\n  return followingCount >= minFollowing && !isPrivate;\n});\n\nconsole.log(`Filtered ${followers.length} followers to ${qualified.length} qualified (following >= ${minFollowing}, public)`);\n\nreturn qualified.map(f => ({\n  json: {\n    username: f.json.username,\n    full_name: f.json.fullName || f.json.full_name || '',\n    following_count: f.json.followsCount || f.json.following_count,\n    follower_count: f.json.followersCount || f.json.follower_count,\n    biography: f.json.biography || f.json.bio || '',\n    is_private: false,\n    config: config\n  }\n}));"
      },
      "id": "filter_by_following",
      "name": "3. Filter: Following >= 750 & Public",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 300],
      "notesInFlow": true,
      "notes": "Only keep followers who follow 750+ people and have public profiles"
    },
    {
      "parameters": {
        "jsCode": "// Infer demographics from profile data\nconst profile = $input.first().json;\n\n// Gender inference from name\nconst maleNames = ['james','john','robert','michael','william','david','richard','joseph','thomas','christopher','charles','daniel','matthew','anthony','mark','donald','steven','paul','andrew','joshua','kenneth','kevin','brian','george','timothy','ronald','edward','jason','jeffrey','ryan','jacob','gary','nicholas','eric','jonathan','stephen','larry','justin','scott','brandon','benjamin','samuel','raymond','gregory','frank','alexander','patrick','jack','dennis','jerry','tyler','aaron','jose','adam','nathan','henry','douglas','zachary','peter','kyle','noah','ethan','jeremy','walter','christian','keith','roger','terry','austin','sean','gerald','carl','harold','dylan','arthur','lawrence','jordan','jesse','bryan','billy','bruce','gabriel','joe','logan','albert','willie','alan','eugene','russell','vincent','philip','bobby','johnny','bradley'];\nconst femaleNames = ['mary','patricia','jennifer','linda','elizabeth','barbara','susan','jessica','sarah','karen','lisa','nancy','betty','margaret','sandra','ashley','kimberly','emily','donna','michelle','dorothy','carol','amanda','melissa','deborah','stephanie','rebecca','sharon','laura','cynthia','kathleen','amy','angela','shirley','anna','brenda','pamela','emma','nicole','helen','samantha','katherine','christine','debra','rachel','carolyn','janet','catherine','maria','heather','diane','ruth','julie','olivia','joyce','virginia','victoria','kelly','lauren','christina','joan','evelyn','judith','megan','andrea','cheryl','hannah','jacqueline','martha','gloria','teresa','ann','sara','madison','frances','kathryn','janice','jean','abigail','alice','judy','sophia','grace','denise','amber','doris','marilyn','danielle','beverly','isabella','theresa','diana','natalie','brittany','charlotte','marie','kayla','alexis','lori'];\n\nconst firstName = (profile.full_name || '').split(' ')[0].toLowerCase();\nlet inferredGender = 'unknown';\nlet genderConfidence = 0;\n\nif (maleNames.includes(firstName)) {\n  inferredGender = 'male';\n  genderConfidence = 0.85;\n} else if (femaleNames.includes(firstName)) {\n  inferredGender = 'female';\n  genderConfidence = 0.85;\n}\n\n// Check bio for gender hints\nconst bio = (profile.biography || '').toLowerCase();\nconst maleKeywords = ['dad', 'father', 'husband', 'he/him', 'businessman', 'mr.', 'king', 'brother'];\nconst femaleKeywords = ['mom', 'mother', 'wife', 'she/her', 'businesswoman', 'mrs.', 'queen', 'sister', 'mama'];\n\nif (maleKeywords.some(k => bio.includes(k))) {\n  inferredGender = 'male';\n  genderConfidence = Math.max(genderConfidence, 0.9);\n}\nif (femaleKeywords.some(k => bio.includes(k))) {\n  inferredGender = 'female';\n  genderConfidence = Math.max(genderConfidence, 0.9);\n}\n\n// Age inference from bio\nlet inferredAgeMin = null;\nlet inferredAgeMax = null;\nlet ageConfidence = 0;\n\n// Look for age patterns\nconst ageMatch = bio.match(/(\\d{1,2})\\s*(?:years?\\s*old|y\\/?o|yrs)/i);\nif (ageMatch) {\n  const age = parseInt(ageMatch[1]);\n  if (age >= 13 && age <= 100) {\n    inferredAgeMin = age - 2;\n    inferredAgeMax = age + 2;\n    ageConfidence = 0.85;\n  }\n}\n\n// Look for birth year\nconst birthMatch = bio.match(/born\\s*(?:in\\s*)?(19|20)(\\d{2})/i);\nif (birthMatch && !inferredAgeMin) {\n  const birthYear = parseInt(birthMatch[1] + birthMatch[2]);\n  const currentYear = new Date().getFullYear();\n  const age = currentYear - birthYear;\n  if (age >= 13 && age <= 100) {\n    inferredAgeMin = age - 1;\n    inferredAgeMax = age + 1;\n    ageConfidence = 0.9;\n  }\n}\n\nreturn [{\n  json: {\n    ...profile,\n    inferred_gender: inferredGender,\n    gender_confidence: genderConfidence,\n    inferred_age_min: inferredAgeMin,\n    inferred_age_max: inferredAgeMax,\n    age_confidence: ageConfidence\n  }\n}];"
      },
